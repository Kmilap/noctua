APP_NAME=Noctua
APP_ENV=lab
APP_KEY=
APP_DEBUG=false
APP_URL=http://localhost:8000

DB_CONNECTION=pgsql
DB_HOST=db
DB_PORT=5432
DB_DATABASE=noctua
DB_USERNAME=noctua
DB_PASSWORD=noctua_secret

SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

REDIS_CLIENT=phpredis
REDIS_HOST=redis
REDIS_PASSWORD=null
REDIS_PORT=6379

MAIL_MAILER=smtp
MAIL_SCHEME=null  # esta se queda igual
MAIL_HOST=smtp.resend.com
MAIL_PORT=587
MAIL_USERNAME=resend
MAIL_PASSWORD=
MAIL_FROM_ADDRESS="noctua@noctuagroup.dev"
MAIL_FROM_NAME="Noctua"
FRONTEND_URL=http://localhost:5173

VITE_APP_NAME="${APP_NAME}"

# Noctua — Configuración de provisioning (Sprint 5+6)
NOCTUA_MAX_CONTAINERS_TOTAL=12
NOCTUA_INTERNAL_API_URL=http://noctua-app:8000/api
NOCTUA_DOCKER_NETWORK=noctua_noctua-network
NOCTUA_RESOURCE_PREFIX=noctua-svc
NOCTUA_HEALTH_CHECK_HOST=host.docker.internal
FRONTEND_URL=http://localhost:5173
UMBRA_LAB_ENABLED=true
UMBRA_DETECTOR_URL=http://detector:8001/analizar
UMBRA_FAIL_MODE=closed
NOCTUA_CONTAINER_PROVISIONING=false
