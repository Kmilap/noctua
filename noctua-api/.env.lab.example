APP_NAME=Noctua

# Perfil Docker (.env.example): APP_ENV=local
# Este perfil (lab, Nginx nativo sin Docker): entorno de producción real.
APP_ENV=production
APP_KEY=

# Perfil Docker (.env.example): APP_DEBUG=true
# Este perfil: nunca exponer stack traces/detalles de error en un entorno accesible por red.
APP_DEBUG=false

# Debe apuntar a la IP (o dominio) de la VM donde corre esta instancia,
# no a localhost — a diferencia del perfil Docker, aquí no hay
# port-forwarding local hacia el contenedor. Sin puerto: Nginx sirve
# en el 80.
APP_URL=http://CAMBIAR_POR_IP_DE_LA_VM

# Perfil Docker (.env.example): DB_HOST=db (nombre del servicio en docker-compose.yml)
# Este perfil: Postgres corre nativo en la misma VM, sin red de Compose.
DB_CONNECTION=pgsql
DB_HOST=127.0.0.1
DB_PORT=5432
DB_DATABASE=noctua
DB_USERNAME=noctua
DB_PASSWORD=CAMBIAR_GENERAR_ALEATORIA

SESSION_DRIVER=redis
SESSION_LIFETIME=120

BROADCAST_CONNECTION=log
FILESYSTEM_DISK=local
QUEUE_CONNECTION=redis
CACHE_STORE=redis

# Perfil Docker (.env.example): REDIS_HOST=redis (nombre del servicio en docker-compose.yml)
# Este perfil: Redis corre nativo en la misma VM, sin red de Compose.
REDIS_CLIENT=phpredis
REDIS_HOST=127.0.0.1
REDIS_PASSWORD=null
REDIS_PORT=6379

# Perfil Docker (.env.example): SMTP real contra Resend, con API key en MAIL_PASSWORD.
# Este perfil: el correo queda fuera del alcance del laboratorio y no
# queremos credenciales en un archivo versionado — MAIL_MAILER=log
# escribe los correos al log en vez de enviarlos.
MAIL_MAILER=log
MAIL_FROM_ADDRESS="noctua@noctuagroup.dev"
MAIL_FROM_NAME="Noctua"

# Mismo valor que APP_URL: en la VM, frontend y API comparten origen
# (Nginx sirve ambos detrás del mismo host/puerto 80), a diferencia del
# perfil Docker donde el frontend corre en su propio puerto (5173).
FRONTEND_URL=http://CAMBIAR_POR_IP_DE_LA_VM

# Hallazgo Fase 5 (28/08/2026), corregido el 16/09/2026: esta clave
# faltaba por completo en este perfil y debe quedar VACIA.
#
# Noctua autentica con tokens Bearer leidos de localStorage
# (noctua-app/src/lib/api.ts). No usa sesiones de SPA: un grep de
# 'csrf-cookie' y 'withCredentials' en todo noctua-app/src/ no devuelve
# nada.
#
# Si la variable se omite, config/sanctum.php construye la lista desde
# APP_URL y FRONTEND_URL. Con la Decision 1 (origen unico) ambas apuntan
# a la IP de la VM, asi que la IP entra DOS VECES en sanctum.stateful.
# Sanctum trata entonces cada peticion del navegador como SPA con sesion
# y exige token CSRF que el frontend nunca envia: el login devuelve 419.
# curl no lo reproduce porque no manda cookies.
#
# Dejarla vacia fuerza la ruta stateless, que es el diseno real de la
# aplicacion. Verificado en noctua-lab: con la IP -> 419; vacia -> 200.
SANCTUM_STATEFUL_DOMAINS=

VITE_APP_NAME="${APP_NAME}"
# ============================================================
# Noctua — Configuración de provisioning (Sprint 5+6)
# ============================================================
# Corrección Fase 5 (28/08/2026): esta variable SÍ está implementada —
# el comentario anterior ("todavía sin implementar") era falso, verificado
# leyendo el código en la VM. config/noctua.php la expone como
# 'container_provisioning' => env('NOCTUA_CONTAINER_PROVISIONING', true),
# y hay tres cortes reales que la leen: routes/console.php envuelve el
# schedule de SyncContainerStatusJob en el if; y ServiceController::store
# (con template_id) / start / stop / restart devuelven 422 con
# provisioningDisabledResponse() antes de invocar ContainerManager. Con
# la bandera en false —como en este perfil— el scheduler no programa el
# sync y esas cuatro rutas responden 422 en vez de fallar contra un
# socket de Docker inexistente.
NOCTUA_CONTAINER_PROVISIONING=false

# Las variables de abajo configuran el provisioning de contenedores vía
# Docker (Sprint 5+6). Este laboratorio no tiene Docker, así que quedan
# comentadas — no aplican mientras NOCTUA_CONTAINER_PROVISIONING=false.
#
# Limite global de contenedores activos (running/starting). 422 al alcanzar.
# Recomendaciones segun RAM del host: 2GB->6, 4GB->12, 8GB->25
# NOCTUA_MAX_CONTAINERS_TOTAL=12

# URL de la API inyectada en cada contenedor provisionado para reportar
# heartbeats y metricas. Usa el alias del servicio Docker en dev.
# NOCTUA_INTERNAL_API_URL=http://noctua-app:8000/api

# Red Docker compartida entre Noctua y los contenedores provisionados.
# Debe coincidir con docker-compose.yml seccion networks.
# NOCTUA_DOCKER_NETWORK=noctua_noctua-network

# Prefijo de nombres de contenedores y volumenes generados.
# Ejemplo: servicio id=42 → "noctua-svc-42".
# NOCTUA_RESOURCE_PREFIX=noctua-svc

# Host accesible desde el contenedor de la API hacia los servicios
# provisionados (URL autogenerada del servicio creado).
#
# Elige UNO segun tu entorno:
#   localhost              → Linux nativo / Hetzner (Noctua y servicios mismo host)
#   host.docker.internal   → WSL2 / macOS (necesario para alcanzar puertos del host)
#   172.17.0.1             → Linux si host.docker.internal no resuelve
# NOCTUA_HEALTH_CHECK_HOST=localhost

# ============================================================
# Claves API de scripts/simulator.py (Fase 2)
# ============================================================
# Marcadores, no valores reales: reemplazalos por la clave en texto
# plano que le hayas asignado a cada servicio en el seeder (la misma
# que ahí se hashea a sha256 hacia Service::api_key_hash — ver
# ApiKeyAuth).
#
# ADVERTENCIA: estas claves son conocidas por diseño (marcadores
# públicos en un archivo versionado). La VM de laboratorio NUNCA debe
# salir de la red host-only — si queda expuesta a internet con estas
# claves sin reemplazar, cualquiera puede autenticarse como estos
# servicios.
NOCTUA_API_KEY_PAGOS=CAMBIAR_API_KEY_PAGOS
NOCTUA_API_KEY_INVENTARIO=CAMBIAR_API_KEY_INVENTARIO
NOCTUA_API_KEY_NOTIFICACIONES=CAMBIAR_API_KEY_NOTIFICACIONES
