# Variables del simulador agresivo de Noctua (Fase 2).
# Copiá este archivo a scripts/.env y completá las API keys.
#
# Las API keys se obtienen creando los servicios externos en Noctua.
# Hoy hay 2 formas:
#   1. Desde la UI (modal post-creación) — pendiente arreglar visualización.
#   2. Vía curl al endpoint POST /api/services con Bearer token.
# El response devuelve `api_key` plain UNA SOLA VEZ.

# URL base de la API. En local apunta al Laravel del docker-compose.
NOCTUA_API_URL=http://localhost:8000/api

# API keys de los 3 servicios simulados (cada uno con su personalidad fija)
NOCTUA_API_KEY_PAGOS=
NOCTUA_API_KEY_INVENTARIO=
NOCTUA_API_KEY_NOTIFICACIONES=
