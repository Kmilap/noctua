# URL base de la API de Noctua para el cliente axios (src/lib/api.ts).
#
# Normalmente se deja SIN DEFINIR: en ese caso el cliente usa '/api'
# (ruta relativa), que en desarrollo pasa por el proxy de Vite
# (vite.config.ts, /api -> http://localhost:8000) y en producción
# asume que el frontend y el backend quedan detrás del mismo origen.
#
# Solo definila si necesitás apuntar a un backend en otro host/puerto.
# VITE_API_URL=http://localhost:8000/api
